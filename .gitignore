# Godot
.godot/
*.translation
export/
builds/
*.apk
*.aab
*.ipa
*.pck
*.zip
*.exe
*.x86_64
*.app
.import/
*.import

# Python legacy tooling caches (when run from archive)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime user data must never be committed. Keep the Godot scan boundary so
# locally retained logs or research assets are not imported as game resources.
artifacts/*
!artifacts/.gdignore
autosave.json
leaderboard.json
.stillpoint/
*.tmp
