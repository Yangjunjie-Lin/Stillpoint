[resource]
script = ExtResource("1")
id = &"cloudowl"
display_name = "Nimbus"
biography = "A cloud owl that chose the player's company after observing their travels from Greywake's rooftops."
species = SubResource("Species")
personality = SubResource("Personality")
base_attributes = SubResource("Attributes")
lifestyles = Array[PetLifestyleDefinition]([SubResource("RestLifestyle"), SubResource("ExploreLifestyle"), SubResource("GuardianLifestyle")])
default_lifestyle_id = &"rest"
life_skills = Array[PetSkillDefinition]([SubResource("ScoutSkill"), SubResource("RoostSkill")])
attack_skills = Array[PetSkillDefinition]([SubResource("TalonSkill")])
equipment_slots = Array[PetEquipmentSlotDefinition]([SubResource("CollarSlot"), SubResource("BodySlot"), SubResource("CharmSlot")])
server_dialogue_profile_id = &"pet:cloudowl"
speech_style_tags = Array[StringName]([&"concise", &"observant", &"airy", &"measured"])
llm_advisory_intent_ids = Array[StringName]([&"seek_affection", &"comment_on_world", &"express_need"])
default_stay_region_id = &"base:player_home"
default_stay_location_id = &"pet_rest_area"
