base_max_health = 32.0
base_max_stamina = 82.0
natural_defense = 0.8
health_gain_per_level = 3.0
stamina_gain_per_level = 4.5
hunger_per_game_hour = 1.05
rest_stamina_per_game_hour = 10.0

