[sub_resource type="Resource" id="Species"]
script = ExtResource("2")
id = &"cloudowl"
display_name = "Cloud Owl"
description = "A light-boned owl companion adapted to high winds, dusk travel, and watching from quiet perches."
species_tags = Array[StringName]([&"owl", &"small_companion", &"avian", &"flying"])
habitat_tags = Array[StringName]([&"highland", &"wilderness", &"town", &"home"])
