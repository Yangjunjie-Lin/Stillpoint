[resource]
script = ExtResource("1")
id = &"ronin"
display_name = "暮雨浪人"
description = "来自群岛战乱年代的无主旅人，在旧日责任与新生道路之间保持克制。沉着观察后才出刀，但外观不限制后续职业。"
appearance_description = "旧斗笠遮住半张脸，短羽织与旅行袴留有风雨磨痕，腰间双鞘以暗红绳结固定。"
