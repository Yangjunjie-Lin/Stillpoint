[resource]
script = ExtResource("1")
id = &"wuxia_swordsman"
display_name = "云游剑客"
description = "出身于东方幻想江湖的游侠。重视承诺、分寸与自由，以轻灵步法寻找值得守护的人与事。外观只代表来历，不限制后续职业。"
appearance_description = "束起长发，穿便于行动的层叠长衫与护腕，腰悬朴素长剑；青玉、墨色与云纹构成主要视觉语言。"
model_scene = ExtResource("2")
