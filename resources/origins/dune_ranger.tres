[resource]
script = ExtResource("1")
id = &"dune_ranger"
display_name = "逐沙游侠"
description = "熟悉风向、星路与荒漠水脉的远行者，擅长在恶劣环境中保存体力并发现安全路径。沙海装束不限制后续职业。"
appearance_description = "靛蓝面巾、浅沙色长披与多层轻甲隔绝烈日，腰带挂有罗盘、绳索和封蜡水囊。"
