[gd_resource type="Resource" script_class="ProfessionDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/profession_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"pathfinder"
display_name = "寻路者"
description = "擅长探索和恶劣环境中的持续行动，特重生命上限。任何出身均可选择。"
accent_color = Color(0.89, 0.68, 0.32, 1)
recommended_origin_ids = Array[StringName]([&"dune_ranger"])
signature_stat = &"max_health_bonus"
starter_items = {"field_pick": 1, "padded_vest": 1, "trail_snack": 3, "training_sword": 1, "wanderer_charm": 1}
