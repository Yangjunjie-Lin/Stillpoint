[gd_resource type="Resource" script_class="SkillDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/skill_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"improvised_weapons"
display_name = "Improvised Weapons"
category = &"combat"
description = "Using working tools safely and effectively when they must serve as weapons."
