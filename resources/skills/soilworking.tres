[gd_resource type="Resource" script_class="SkillDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/skill_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"soilworking"
display_name = "Soilworking"
category = &"life"
description = "Preparing soil while preserving its structure and the worker's body."
