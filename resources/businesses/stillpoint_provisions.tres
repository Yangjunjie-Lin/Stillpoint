"trail_snack": 8,
"turnip": 12
}
stock_targets = {
"trail_snack": 8,
"turnip": 12
}
buy_categories = Array[StringName]([&"consumables"])
sell_categories = Array[StringName]([&"consumables"])
reserve_cash = 50
