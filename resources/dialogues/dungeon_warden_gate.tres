[sub_resource type="Resource" id="Start"]
script = ExtResource("2")
id = &"start"
speaker = "Warden Aster"
lines = PackedStringArray("This is the Warden's Threshold. I can send you only as deep as your combat training allows.")
choices = Array[ExtResource("3")]([SubResource("ChoiceDepth1"), SubResource("ChoiceDepth2"), SubResource("ChoiceDepth3"), SubResource("ChoiceLore"), SubResource("ChoiceLeave")])

[sub_resource type="Resource" id="Lore"]
script = ExtResource("2")
id = &"lore"
speaker = "Warden Aster"
lines = PackedStringArray("The Hollow lies beneath the Greywake Wilds. Its three guardians reform after several days; only witnessed reports and what travelers tell me change what I know of each return.")

[resource]
script = ExtResource("1")
id = &"dungeon_warden_gate"
nodes = Array[ExtResource("2")]([SubResource("Start"), SubResource("Lore")])
start_node_id = &"start"
